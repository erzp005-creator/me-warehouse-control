{
  "expo": {
    "name": "ME Warehouse Control",
    "slug": "me-warehouse-control",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.megroup.warehousecontrol",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan courier barcodes and take receiving or mistake evidence photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.megroup.warehousecontrol",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Allow ME Warehouse Control to take receiving and mistake evidence photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ME Warehouse Control to scan courier barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-splash-screen",
      "./plugins/chainway-scanner",
      "./plugins/with-cleartext-traffic"
    ]
  }
}

